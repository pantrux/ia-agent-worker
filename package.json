{
  "name": "ia-agent-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless IA Agent (LangGraph.js) on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "studio": "langgraphjs dev -h 0.0.0.0 -p 2024",
    "studio:tunnel": "langgraphjs dev -h 0.0.0.0 -p 2024 --tunnel",
    "studio:check": "node ./scripts/studio-check.mjs",
    "smoke:worker": "node ./scripts/smoke-worker.mjs",
    "provision:ai-gateway": "node ./scripts/provision-ai-gateway.mjs",
    "check:ai-gateway": "node ./scripts/cf-ai-gateway-status.mjs",
    "rotate:bff-secret": "node ./scripts/rotate-bff-secret.mjs",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create ia-agent-db",
    "db:migrate": "wrangler d1 execute ia-agent-db --file=schema.sql",
    "db:seed": "wrangler d1 execute ia-agent-db --file=seed.sql",
    "db:migrate:local": "wrangler d1 execute ia-agent-db --local --file=schema.sql",
    "db:seed:local": "wrangler d1 execute ia-agent-db --local --file=seed.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/core": "^0.3",
    "@langchain/langgraph": "^0.2",
    "@langchain/openai": "^0.5",
    "langsmith": "^0.3.76",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260501",
    "@langchain/langgraph-cli": "^0.0.40",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "sql.js": "^1.11.0",
    "typescript": "^5.7",
    "vitest": "^4.1.6",
    "wrangler": "^4"
  }
}
