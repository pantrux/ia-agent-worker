# Copiar a `.dev.vars` (no versionar). Wrangler carga estos valores como secretos/vars locales.
# Ver README: COPILOT_GITHUB_TOKEN, LANGSMITH_API_KEY, BFF_API_TOKEN opcional.

COPILOT_GITHUB_TOKEN=
# Opcional — si se define, POST /api/chat y /api/chat/resume exigen el mismo Bearer
BFF_API_TOKEN=
# Opcional — AI Gateway (compat): mismo patrón que wrangler.toml / README
# AI_GATEWAY_ACCOUNT_ID=
# AI_GATEWAY_ID=
# AI_GATEWAY_API_TOKEN=
# AI_GATEWAY_PROVIDER_SLUG=
