# Copiar a `.dev.vars` (no versionar). Wrangler carga estos valores como secretos/vars locales.
# Ver README: COPILOT_GITHUB_TOKEN, LANGSMITH_API_KEY, BFF_API_TOKEN opcional.

COPILOT_GITHUB_TOKEN=
# Opcional — si se define, POST /api/chat y /api/chat/resume exigen el mismo Bearer
BFF_API_TOKEN=
# PAN-18: token de @BotFather (tambien: npx wrangler secret put TELEGRAM_BOT_TOKEN --env="")
# TELEGRAM_BOT_TOKEN=

# PAN-37: Bot User OAuth Token (xoxb-…) de la Slack App
# SLACK_BOT_TOKEN=
# Opcional — AI Gateway (compat sin slug, o …/custom-{slug} con AI_GATEWAY_PROVIDER_SLUG)
# AI_GATEWAY_ACCOUNT_ID=
# AI_GATEWAY_ID=
# AI_GATEWAY_API_TOKEN=
# Opcional — depuración: 500 de /api/chat con detail/stack (no en prod pública)
# EXPOSE_CHAT_ERROR=true
