# Copiar a `.env.ai-gateway.local` (no versionar) **o** definir las mismas claves en `.env` en la raíz del repo.
# API Token: permisos «Account — AI Gateway — Edit» (crear en https://dash.cloudflare.com/?to=/:account/api-tokens )
# Guardar este fichero como UTF-8. Una línea, sin espacio antes del =. Ejemplo:
# CF_AI_GATEWAY_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

CF_AI_GATEWAY_API_TOKEN=

# Opcional: si GET /accounts falla por permisos del token, fija la cuenta a mano (Workers / URL del dashboard).
# CLOUDFLARE_ACCOUNT_ID=

# Opcionales (coinciden con el script por defecto)
# AI_GATEWAY_ID=ia-agent-worker-llm
# AI_GATEWAY_PROVIDER_SLUG=github-models
# AI_GATEWAY_CUSTOM_BASE_URL=https://models.github.ai
#
# Segundo proveedor (Copilot Enterprise) — también lo crea provision-ai-gateway
# AI_GATEWAY_COPILOT_SLUG=github-copilot-enterprise
# AI_GATEWAY_COPILOT_BASE_URL=https://api.enterprise.githubcopilot.com
# AI_GATEWAY_SKIP_COPILOT_PROVIDER=1
