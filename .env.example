# GitHub token for GitHub Models / Copilot (same as COPILOT_GITHUB_TOKEN in Wrangler secrets).
# Copilot (ghu_*): `npx wrangler secret put COPILOT_GITHUB_TOKEN` (no commitear el valor).
COPILOT_GITHUB_TOKEN=

# Model and API base (match wrangler.toml [vars] by default)
COPILOT_MODEL=gpt-5.4
OPENAI_API_BASE=https://api.enterprise.githubcopilot.com
# GitHub Models (alternativa): OPENAI_API_BASE=https://models.github.ai/inference y COPILOT_MODEL=openai/gpt-4o-mini
# Opcional: si los modelos están solo en una org, login de la org (p. ej. mi-org) → …/orgs/{org}/inference
# GITHUB_MODELS_ORG=
# GITHUB_MODELS_API_VERSION=2026-03-10

# Token solo para AI Gateway (recomendado). Lo leen `npm run provision:ai-gateway` y `npm run check:ai-gateway`.
# No uses CLOUDFLARE_API_TOKEN en `.env` para esto si haces `wrangler deploy` con OAuth: Wrangler tomaría ese token y puede fallar sin permiso Workers.
# Fichero `.env` en la raíz del repo (gitignored). Permisos típicos: Account → AI Gateway — Edit; Account → Read.
CF_AI_GATEWAY_API_TOKEN=
# CLOUDFLARE_API_TOKEN=   # solo si quieres que Wrangler use API Token en lugar de OAuth (permisos Workers + cuenta)
# CLOUDFLARE_ACCOUNT_ID=

# CORS not used by Agent Server; placeholder for shared Env type
ALLOWED_ORIGINS=http://localhost:3000

# LangSmith Studio: usa baseUrl http://127.0.0.1:2024 (coincide con `npm run studio`) o la URL del túnel si usas `npm run studio:tunnel`.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ia-agent-worker-studio
LANGCHAIN_CALLBACKS_BACKGROUND=false
# B3 — dataset/eval (scripts langsmith:*); nombre del dataset en LangSmith (por defecto = datasetName del JSON)
#LANGSMITH_EVAL_DATASET_NAME=ia-agent-worker-eval-v0
#EVAL_MIN_MEAN_SCORE=0.875
#LANGSMITH_EXPERIMENT_PREFIX=local

# Smoke / eval remota (misma URL que GitHub variable WORKER_SMOKE_URL)
#WORKER_SMOKE_URL=
#WORKER_SMOKE_BFF_TOKEN=

# Opcional: production | preview — metadata LangSmith `deployment` en rutas HTTP del Worker
DEPLOYMENT_ENV=

# Opcional — Cloudflare AI Gateway (LangGraph Studio / mismo contrato que Worker)
# Tras `npm run provision:ai-gateway`, alinea slug/path con wrangler (Copilot: github-copilot-enterprise + v1).
# AI_GATEWAY_ACCOUNT_ID=
# AI_GATEWAY_ID=
# AI_GATEWAY_API_TOKEN=
# AI_GATEWAY_PROVIDER_SLUG=github-copilot-enterprise
# Opcional; vacío para Copilot. Para GitHub Models usar "inference".
AI_GATEWAY_PROVIDER_PATH=""
# AI_GATEWAY_DISABLED=true
