# GitHub token for GitHub Models / Copilot (same as COPILOT_GITHUB_TOKEN in Wrangler secrets)
COPILOT_GITHUB_TOKEN=

# Model and API base (match wrangler.toml [vars] by default)
COPILOT_MODEL=openai/gpt-5.4-mini
OPENAI_API_BASE=https://models.github.ai/inference

# Token solo para AI Gateway (recomendado). Lo leen `npm run provision:ai-gateway` y `npm run check:ai-gateway`.
# No uses CLOUDFLARE_API_TOKEN en `.env` para esto si haces `wrangler deploy` con OAuth: Wrangler tomaría ese token y puede fallar sin permiso Workers.
# Fichero `.env` en la raíz del repo (gitignored). Permisos típicos: Account → AI Gateway — Edit; Account → Read.
CF_AI_GATEWAY_API_TOKEN=
# CLOUDFLARE_API_TOKEN=   # solo si quieres que Wrangler use API Token en lugar de OAuth (permisos Workers + cuenta)
# CLOUDFLARE_ACCOUNT_ID=

# CORS not used by Agent Server; placeholder for shared Env type
ALLOWED_ORIGINS=http://localhost:3000

# LangSmith Studio: usa baseUrl http://127.0.0.1:2024 (coincide con `npm run studio`) o la URL del túnel si usas `npm run studio:tunnel`.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ia-agent-worker-studio
LANGCHAIN_CALLBACKS_BACKGROUND=false

# Opcional: production | preview — metadata LangSmith `deployment` en rutas HTTP del Worker
DEPLOYMENT_ENV=

# Opcional — Cloudflare AI Gateway (LangGraph Studio / mismo contrato que Worker)
# AI_GATEWAY_ACCOUNT_ID=
# AI_GATEWAY_ID=
# AI_GATEWAY_API_TOKEN=
# AI_GATEWAY_PROVIDER_SLUG=
# AI_GATEWAY_PROVIDER_PATH=inference
